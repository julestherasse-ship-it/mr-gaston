# Optional. Canonical public URL of the live site, no trailing slash.
# Fallback in code: https://mrgaston.be
# On Netlify production, set only when the live origin is confirmed.
# Do NOT point DNS yet during migration tests — use the Netlify URL temporarily if needed.
# NEXT_PUBLIC_SITE_URL=https://mrgaston.be

# Optional. Google Search Console verification token (content value only).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional analytics — inlined at build time.
# Loaded only on indexable production deploys (Vercel production / Netlify CONTEXT=production).
# Prefer GTM. Use GA4 only if GTM is not set.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX

# Injected by platforms — do not invent or commit these:
# VERCEL_ENV (Vercel) · CONTEXT (Netlify) · NODE_ENV
